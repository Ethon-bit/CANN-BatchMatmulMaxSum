// ============================================================================
// BatchMatmulMaxSum —— 通用本地测试入口
//
// 与比赛模板的区别：形状不写死在代码里，而是运行时从 ./case.txt 读。
// 因此**一次编译可以跑所有用例**，换形状不用重新 make。
//
// case.txt 格式（一行，空格分隔）：
//     B  M  N  K  dtype  transposeX1  transposeX2  shape_mode
//
//   dtype      : 0=float32  1=float16  2=bfloat16
//   transposeX1: 0/1
//   transposeX2: 0/1
//   shape_mode : 0 = TensorGroupInfo 填【逻辑形状】x1=(B,M,K) x2=(B,K,N)
//                1 = TensorGroupInfo 填【存储形状】x1=(B, tx1?K:M, tx1?M:K)
//                                                    x2=(B, tx2?N:K, tx2?K:N)
//
//   ★ shape_mode 就是用来一次性判定那个悬案的：同一个用例分别用 0 和 1 跑，
//     哪个和 golden 对得上，哪种解释就是对的。
//
// 输入文件：./input/x1.bin、./input/x2.bin（按物理布局摆放的裸二进制）
// 输出文件：./output/y.bin（B 个 float32）
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <fstream>
#include <string>
#include <vector>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// dtype 编码（与平台一致）：
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expr) do {                                                   \
    aclError _r = (expr);                                                      \
    if (_r != 0) {                                                             \
        fprintf(stderr, "[ERROR] %s 失败, ret=%d, 行 %d\n", #expr, _r, __LINE__); \
        return 1;                                                              \
    }                                                                          \
} while (0)

#include "kernel.asc"

// 每个元素的字节数
static size_t ElemBytes(int dtype)
{
    switch (dtype) {
        case 0: return 4;   // float32
        case 1: return 2;   // float16
        case 2: return 2;   // bfloat16
        default: return 2;
    }
}

int main()
{
    // ---------- 1. 读用例描述 ----------
    int64_t B = 0, M = 0, N = 0, K = 0;
    int dtype = 1, tx1 = 0, tx2 = 0, shapeMode = 0;
    {
        std::ifstream f("./case.txt");
        if (!f.is_open()) {
            fprintf(stderr, "[ERROR] 找不到 ./case.txt\n");
            return 1;
        }
        if (!(f >> B >> M >> N >> K >> dtype >> tx1 >> tx2 >> shapeMode)) {
            fprintf(stderr, "[ERROR] ./case.txt 格式不对，应为：\n"
                            "        B M N K dtype transposeX1 transposeX2 shape_mode\n");
            return 1;
        }
    }

    const bool tX1 = (tx1 != 0);
    const bool tX2 = (tx2 != 0);
    const size_t eb = ElemBytes(dtype);

    // ---------- 2. 物理形状（数据文件就是这个布局） ----------
    //   transposeX1=false -> x1 (B, M, K)   true -> x1 (B, K, M)
    //   transposeX2=false -> x2 (B, K, N)   true -> x2 (B, N, K)
    const int64_t x1Phys[3] = { B, tX1 ? K : M, tX1 ? M : K };
    const int64_t x2Phys[3] = { B, tX2 ? N : K, tX2 ? K : N };

    // ---------- 3. TensorGroupInfo 里填什么（由 shape_mode 决定） ----------
    const int64_t x1Logical[3] = { B, M, K };   // 逻辑形状恒为 (B,M,K)
    const int64_t x2Logical[3] = { B, K, N };   // 逻辑形状恒为 (B,K,N)

    const int64_t* x1Shape = (shapeMode == 0) ? x1Logical : x1Phys;
    const int64_t* x2Shape = (shapeMode == 0) ? x2Logical : x2Phys;
    const int64_t yShape[1]  = { B };

    // ---------- 4. 缓冲区大小（逻辑/物理的元素总数相同） ----------
    const size_t x1Bytes = static_cast<size_t>(B) * M * K * eb;
    const size_t x2Bytes = static_cast<size_t>(B) * K * N * eb;
    const size_t yBytes  = static_cast<size_t>(B) * 4;   // 输出恒为 float32

    printf("[case] B=%lld M=%lld N=%lld K=%lld dtype=%d tx1=%d tx2=%d shape_mode=%d\n",
           (long long)B, (long long)M, (long long)N, (long long)K, dtype, tx1, tx2, shapeMode);
    printf("[physical] x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld)  bytes: x1=%zu x2=%zu y=%zu\n",
           (long long)x1Phys[0], (long long)x1Phys[1], (long long)x1Phys[2],
           (long long)x2Phys[0], (long long)x2Phys[1], (long long)x2Phys[2],
           x1Bytes, x2Bytes, yBytes);
    printf("[reported] x1=(%lld,%lld,%lld) x2=(%lld,%lld,%lld)  <- 填进 TensorGroupInfo 的\n",
           (long long)x1Shape[0], (long long)x1Shape[1], (long long)x1Shape[2],
           (long long)x2Shape[0], (long long)x2Shape[1], (long long)x2Shape[2]);

    // ---------- 5. 初始化 ACL ----------
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        fprintf(stderr, "[ERROR] 拿不到可用的 Cube 核数\n");
        return 1;
    }
    printf("[env] availableCoreNum=%lld\n", (long long)availableCoreNum);
    ACL_CHECK(aclrtCreateStream(&stream));

    // ---------- 6. 准备张量 ----------
    TensorInfo x1Tensors[1] = { { x1Shape, 3, dtype } };
    TensorGroupInfo info_x1 = { x1Tensors, 1 };
    TensorInfo x2Tensors[1] = { { x2Shape, 3, dtype } };
    TensorGroupInfo info_x2 = { x2Tensors, 1 };
    TensorInfo yTensors[1]  = { { yShape, 1, 0 } };      // 0 = float32
    TensorGroupInfo info_y  = { yTensors, 1 };

    uint8_t* hostX1 = nullptr;  uint8_t* devX1 = nullptr;
    uint8_t* hostX2 = nullptr;  uint8_t* devX2 = nullptr;
    uint8_t* hostY  = nullptr;  uint8_t* devY  = nullptr;

    ACL_CHECK(aclrtMallocHost((void**)&hostX1, x1Bytes));
    ACL_CHECK(aclrtMalloc((void**)&devX1, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x1.bin", x1Bytes, hostX1, x1Bytes)) {
        fprintf(stderr, "[ERROR] 读不到 ./input/x1.bin（期望 %zu 字节）\n", x1Bytes);
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(devX1, x1Bytes, hostX1, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void**)&hostX2, x2Bytes));
    ACL_CHECK(aclrtMalloc((void**)&devX2, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x2.bin", x2Bytes, hostX2, x2Bytes)) {
        fprintf(stderr, "[ERROR] 读不到 ./input/x2.bin（期望 %zu 字节）\n", x2Bytes);
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(devX2, x2Bytes, hostX2, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void**)&hostY, yBytes));
    ACL_CHECK(aclrtMalloc((void**)&devY, yBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    // ---------- 7. 调用算子 ----------
    run_kernel((GM_ADDR)devX1, info_x1,
               (GM_ADDR)devX2, info_x2,
               (GM_ADDR)devY,  info_y,
               availableCoreNum, stream, tX1, tX2);

    // 超时保护：卡死时不至于永远挂着
    auto syncRet = aclrtSynchronizeStreamWithTimeout(stream, 30000);
    if (syncRet != 0) {
        fprintf(stderr, "[ERROR] 同步失败或超时, ret=%d —— 算子可能卡死了\n", syncRet);
        return 2;   // ← 用退出码 2 和普通失败区分开
    }

    // ---------- 8. 取回并保存 ----------
    ACL_CHECK(aclrtMemcpy(hostY, yBytes, devY, yBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile("./output/y.bin", hostY, yBytes)) {
        fprintf(stderr, "[ERROR] 写不了 ./output/y.bin\n");
        return 1;
    }

    // ---------- 9. 清理 ----------
    if (devX1)  aclrtFree(devX1);
    if (hostX1) aclrtFreeHost(hostX1);
    if (devX2)  aclrtFree(devX2);
    if (hostX2) aclrtFreeHost(hostX2);
    if (devY)   aclrtFree(devY);
    if (hostY)  aclrtFreeHost(hostY);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("[ok] 输出已写入 ./output/y.bin\n");
    return 0;
}
