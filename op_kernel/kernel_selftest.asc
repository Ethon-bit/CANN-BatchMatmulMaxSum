/*
 * ===========================================================================
 * harness 自检用 kernel —— 不参与比赛提交，只用来验证本地测试框架本身
 * ===========================================================================
 *
 * 它**故意什么都不算**，只做一件事：
 *
 *      y[b] = 1000.0 + b          （b = 0 .. B-1）
 *
 * 为什么这样能验证框架？
 *
 *   "kernel 算错了" 和 "框架接线错了" 是两种完全不同的故障，
 *   但它们在测试输出上长得一模一样（都是"实际值 != 期望值"）。
 *   这个 kernel 把答案写成了**不用计算就知道的东西**：
 *
 *       case01（B=1） 应该读回 [1000.0]
 *       case09（B=8） 应该读回 [1000,1001,...,1007]
 *
 *   只要读回的值对得上，就证明了整条链路的每一环都是对的：
 *
 *     ① main.asc 正确解析了 cases.txt / case.txt
 *     ② x1/x2/y 的 device 缓冲开得对、地址传得对
 *     ③ run_kernel 真正被调用、kernel 真正被启动
 *     ④ blockNum（核数）算得对 —— B=8 时 8 个核各写各的
 *     ⑤ y 的偏移写法 yGm[b] 与宿主侧读回方式一致
 *     ⑥ golden 读回、比较、打印的流程没串位
 *
 *   反过来说：如果这个 kernel 都读不回 1000.0+b，
 *   那么之前所有"版本 A 本地 0/32"的结论**全部作废**，
 *   必须先修框架，不能在 kernel 上瞎改。
 * ===========================================================================
 */

// 这个文件是被 main.asc #include 进去的，不要加 main() / include guard。

// ---------------------------------------------------------------------------
// device 侧：每个核写自己负责的那些 batch
// ---------------------------------------------------------------------------

__global__ __aicore__ void bmms_selftest(GM_ADDR y, int64_t B)
{
    __gm__ float* yGm = reinterpret_cast<__gm__ float*>(y);
    // 和真 kernel 完全同款的循环写法，才能验证核间分工没错
    for (int64_t b = GetBlockIdx(); b < B; b += GetBlockNum()) {
        yGm[b] = 1000.0f + static_cast<float>(b);
    }
}

// ---------------------------------------------------------------------------
// Host 侧入口
// ---------------------------------------------------------------------------

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    (void)x1; (void)x2; (void)info_x2; (void)info_y;
    (void)transposeX1; (void)transposeX2;

    // 只读一个数：B。读法必须和真 kernel 完全一致，
    // 否则就验证不了"形状解析"这一环。
    const int64_t B = info_x1.tensors[0].shape[0];

    int64_t blockNum = (B < availableCoreNum) ? B : availableCoreNum;
    if (blockNum < 1) { blockNum = 1; }

    printf("[selftest] B=%lld availableCoreNum=%lld -> blockNum=%lld\n",
           (long long)B, (long long)availableCoreNum, (long long)blockNum);

    bmms_selftest<<<blockNum, nullptr, stream>>>(y, B);
    aclrtSynchronizeStream(stream);
}
